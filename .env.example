# Porta do servidor
PORT=3000

# Duffel (voos e hospedagem). Comece com o token de teste: duffel_test_...
DUFFEL_ACCESS_TOKEN=
# DUFFEL_API_VERSION=v2

# OpenRouteService (tempos reais a pé). Opcional.
ORS_API_KEY=

# Identificação exigida pelos serviços públicos do OpenStreetMap (inclua um contato)
HTTP_USER_AGENT=Trajeto/0.1 (contato: seu-email@exemplo.com)

# Pasta para roteiros salvos e registro de cotações
# DATA_DIR=./data

# Instâncias próprias (opcional)
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# 1 = força o modo demonstração (preços ilustrativos)
DEMO_MODE=0
